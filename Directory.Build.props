<Project>
  <!-- Shared build settings for every project in Djancoeg Tournament. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1711;CA1062;CA1515;CA1031;CA1051;CA1707;CA1716;CA1720;CA1724;CA1815;CA1819;CA1822;CA1848;CA2225;CA1000;CA1003;CA1028;CA1034;CA1305;CA1310;CA1303;CA1307;CA1308;CA1311;CA1812;CA5394;CA1814;CA1002;CA1024;CA1043;CA1065;CA1805;CA2201;CA1854;CA1859;CA1861;CA1823;CA2000</NoWarn>
    <Authors>Ariana Mischa Fadhila</Authors>
    <Company>Syubadubin Studios</Company>
    <Product>Djancoeg Tournament</Product>
    <Description>Djancoeg Tournament - Ultimate Indonesian Chaos Battle Arena. Dibuat oleh Ariana Mischa Fadhila dari Syubadubin Studios.</Description>
    <Copyright>(c) 2026 Syubadubin Studios</Copyright>
    <Version>1.3.0</Version>
  </PropertyGroup>
</Project>
