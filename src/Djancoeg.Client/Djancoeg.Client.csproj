<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DjancoegTournament</AssemblyName>
    <!-- No ICU dependency: all formatting uses InvariantCulture and UI text comes from our own EN/ID tables. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Screens own disposables released in Leave(); Theme fonts are mutable by design (loaded after window init). -->
    <NoWarn>$(NoWarn);CA1001;CA2211;CA1863</NoWarn>
    <ApplicationIcon Condition="Exists('..\..\assets\icon\djancoeg.ico')">..\..\assets\icon\djancoeg.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
  </ItemGroup>
  <!-- Steam build (Windows x64): dotnet publish -r win-x64 -p:Steam=true. Off by default; no Steam code or DLLs otherwise. -->
  <PropertyGroup Condition="'$(Steam)' == 'true'">
    <DefineConstants>$(DefineConstants);STEAM</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Steam)' == 'true'">
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" GeneratePathProperty="true" />
    <!-- The package keeps the native Steam API under content/, which PackageReference doesn't copy. -->
    <None Include="$(PkgFacepunch_Steamworks)\content\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Djancoeg.Net\Djancoeg.Net.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Raw Rodin exports in models/source are kept in the repo for reference but never shipped. -->
    <None Include="..\..\assets\**\*" Exclude="..\..\assets\models\source\**" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\mods\**\*" LinkBase="mods" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
